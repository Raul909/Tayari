# Cloudflare Pages response headers.
#
# Everything under /_next/static is content-hashed, so a file at a given URL
# never changes — let browsers keep it for a year and skip the revalidation
# round-trip on every repeat visit, which on a 2G link is most of the wait.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.json
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), geolocation=(self), microphone=()
